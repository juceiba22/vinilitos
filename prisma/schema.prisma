generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Page {
  id         String   @id @default(cuid())
  slug       String   @unique
  // Código secreto que el admin genera al publicar la página y le entrega al
  // artista para que pueda editarla después (sumar miembros, fotos, etc.).
  // Null mientras la página está en borrador y todavía no se publicó.
  editToken  String?  @unique
  artistName String
  albumTitle String?
  bio        String?
  coverImageUrl String?
  themeColor String   @default("#1a1310")
  // El admin arma la página (carga links, genera códigos) en borrador antes
  // de publicarla. Solo una página publicada es visible en /[slug].
  published  Boolean  @default(false)
  // Vencimiento de la suscripción anual. Se fija a la fecha de publicación +
  // 1 año, y cada RenewalCode canjeado la extiende otro año. Pasada esta
  // fecha la página pública deja de mostrar los links.
  subscriptionExpiresAt DateTime
  // Mail del músico para avisarle antes de que venza. Opcional: sin mail
  // cargado no hay a quién avisar.
  contactEmail       String?
  lastReminderSentAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  links         Link[]
  renewalCodes  RenewalCode[]
}

// Un código de renovación extiende un año más la suscripción de una página
// ya existente. Se genera en lote y representa un pago ya cobrado
// (presencial hoy; el mismo mecanismo puede dispararse desde un webhook de
// pago online el día que exista ese canal). Se canjea desde el editor de la
// propia página, autenticado con su editToken.
model RenewalCode {
  id        String    @id @default(cuid())
  code      String    @unique
  batchName String?
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  page   Page?   @relation(fields: [pageId], references: [id])
  pageId String?
}

model Link {
  id           String   @id @default(cuid())
  page         Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId       String
  url          String
  platform     String // spotify | youtube | soundcloud | appleMusic | bandcamp | other
  title        String?
  thumbnailUrl String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  code LinkCode?
}

// El código QR/NFC grabado en el vinilito físico correspondiente a este
// link puntual (un tema o álbum), en relación 1:1. Escanearlo lleva a
// /t/[code], que muestra la portada/título de este link y un botón para
// abrirlo.
model LinkCode {
  id     String @id @default(cuid())
  code   String @unique
  link   Link   @relation(fields: [linkId], references: [id], onDelete: Cascade)
  linkId String @unique

  // Marcado desde el panel admin cuando Vinilitos ya grabó este código en el
  // NFC del vinilito físico correspondiente.
  nfcWritten   Boolean   @default(false)
  nfcWrittenAt DateTime?

  scannedCount Int      @default(0)
  createdAt    DateTime @default(now())
}
