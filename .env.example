DATABASE_URL="postgresql://user:password@host:5432/vinilitos"

# Secreto que protege /api/cron/send-reminders. En Vercel, si configurás esta
# misma variable en el proyecto, Vercel Cron la manda sola como
# "Authorization: Bearer <CRON_SECRET>" en cada llamada programada.
CRON_SECRET="cambiar-por-un-secreto-random"

# Sin esto seteada, los mails de aviso de vencimiento se loguean en la
# consola del server en vez de enviarse de verdad. Conseguí una gratis en
# https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="Vinilitos <onboarding@resend.dev>"

# Usada para armar el link al editor dentro del mail de aviso.
APP_URL="http://localhost:3000"

# Contraseña compartida para entrar a /admin (generar códigos, ver páginas).
ADMIN_PASSWORD="cambiar-por-una-contraseña-fuerte"

# Cloudflare R2: donde se guardan las fotos de la solapa "Backstage".
# - R2_ACCOUNT_ID: el Account ID de Cloudflare (Dashboard > R2 > panel derecho).
# - R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: R2 > "Manage API tokens" >
#   Create API token con permiso "Object Read & Write" sobre el bucket.
# - R2_BUCKET: nombre del bucket.
# - R2_PUBLIC_URL: URL pública del bucket (dominio propio o el r2.dev que
#   se habilita en Settings > Public access), sin barra final.
# El bucket necesita una regla CORS que permita PUT desde el sitio, p. ej.:
# [{"AllowedOrigins":["http://localhost:3000","https://tu-dominio.com"],
#   "AllowedMethods":["PUT"],"AllowedHeaders":["Content-Type"],"MaxAgeSeconds":3600}]
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""
